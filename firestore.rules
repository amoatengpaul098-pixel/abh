rules_version='2';service cloud.firestore{match /databases/{database}/documents{
match /users/{uid}{allow read:if request.auth!=null;allow create,update:if request.auth!=null&&request.auth.uid==uid;}
match /businesses/{id}{allow read:if true;allow write:if request.auth!=null&&request.auth.token.admin==true;}
match /orders/{id}{allow read,create,update:if request.auth!=null;}
match /messages/{id}{allow read,create,update:if request.auth!=null;}
match /notifications/{id}{allow read,update:if request.auth!=null;}
match /{document=**}{allow read,write:if false;}
}}